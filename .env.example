PORT=3000
FRONTEND_URL=http://localhost:5173
# URL pública del backend (sin /api): con ella se arman las URLs de logos y fotos subidos
PUBLIC_API_URL=http://localhost:3000

DATABASE_URL="postgresql://agenda:agenda@localhost:5432/agenda_turnos?schema=public"

JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=1d

# Correo (Amazon SES por SMTP). Sin SMTP_HOST, los correos se guardan en backend/.emails
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="AgendaBarrio <tu-correo-verificado@ejemplo.com>"

# WhatsApp Cloud API (Meta). Sin WHATSAPP_TOKEN, los mensajes se guardan en backend/.whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# Número que verán los clientes en el enlace "Reservar por WhatsApp" (solo dígitos, con indicativo)
WHATSAPP_DISPLAY_NUMBER=
# Webhook: el token que tú inventas y pegas en Meta, y el App Secret (Configuración de la app → Básica)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
WHATSAPP_TEMPLATE_LANGUAGE=es
